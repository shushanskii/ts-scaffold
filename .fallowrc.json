{
  "$schema": "./node_modules/fallow/schema.json",
  "entry": ["apps/api/src/main.ts", "apps/web/src/main.tsx"],
  "boundaries": {
    "zones": [
      { "name": "shared", "patterns": ["packages/shared/src/**"] },
      { "name": "api", "patterns": ["apps/api/src/**"] },
      { "name": "web", "patterns": ["apps/web/src/**"] }
    ],
    "rules": [
      { "from": "shared", "allow": ["shared"] },
      { "from": "api", "allow": ["api", "shared"] },
      { "from": "web", "allow": ["web", "shared"] }
    ]
  }
}
