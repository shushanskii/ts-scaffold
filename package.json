{
  "name": "ts-scaffold",
  "private": true,
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "biome check .",
    "deadcode": "fallow dead-code --fail-on-issues",
    "audit": "turbo run typecheck && biome check . && fallow dead-code --fail-on-issues",
    "fix": "biome check --write .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "fallow": "^3.3.0",
    "husky": "^9.1.7",
    "turbo": "^2.3.0",
    "typescript": "^7.0.2"
  }
}